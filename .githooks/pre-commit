#!/bin/bash
# Pre-commit hook: auto-format Rust code to match CI (cargo fmt --all -- --check)

# Only run if there are staged .rs files
RUST_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.rs$' || true)

if [ -z "$RUST_FILES" ]; then
    exit 0
fi

echo "Running cargo fmt..."

# Use cargo fmt (matches CI exactly) instead of per-file rustfmt
cargo fmt --all

# Re-stage any files that were reformatted
for file in $RUST_FILES; do
    if [ -f "$file" ]; then
        git add "$file"
    fi
done

echo "Formatted and re-staged."
exit 0
