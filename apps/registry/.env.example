# Registry Server Configuration

# === Network ===
# Port the HTTPS server listens on. Default: 7890.
PAP_REGISTRY_PORT=7890

# Host to bind to. Default: 0.0.0.0.
PAP_REGISTRY_HOST=0.0.0.0

# Public endpoint URL advertised to federation peers.
# Example: https://registry.example.com:7890
# If not set, derived from host and port.
# PAP_REGISTRY_ENDPOINT=https://registry.example.com:7890

# Disable TLS and serve over plain HTTP (development only).
# Default: false. Set to 1 or true.
# PAP_REGISTRY_NO_TLS=false

# === Authentication ===

# Bearer token required for admin API routes.
# If not set, admin routes are unrestricted (suitable for trusted networks).
# Generate with: openssl rand -base64 32
# PAP_REGISTRY_ADMIN_TOKEN=your-secret-token-here

# Require authentication on startup.
# If true, the server refuses to start if admin_token is not set.
# Default: false. Set to 1 or true.
# PAP_REGISTRY_REQUIRE_AUTH=false

# === OIDC Configuration ===

# OIDC issuer URL for token validation.
# Example: https://example.okta.com
# If set, enables OIDC bearer token validation.
# PAP_REGISTRY_OIDC_ISSUER=https://your-oidc-provider.example.com

# OIDC audience identifier for token validation.
# Must match the "aud" claim in OIDC tokens.
# Example: registry-api
# PAP_REGISTRY_OIDC_AUDIENCE=registry-api

# === API Keys ===

# Enable API key authentication for programmatic access.
# When true, clients can authenticate using API keys stored in AWS Secrets Manager.
# Default: false. Set to 1 or true.
# PAP_REGISTRY_ENABLE_API_KEYS=false

# === AWS Configuration ===

# AWS region for accessing secrets and other AWS services.
# Default: us-east-1
# PAP_REGISTRY_AWS_REGION=us-east-1

# === Rate Limiting ===

# Sustained request rate per second per IP address for the leaky-bucket rate limiter.
# Default: 20
PAP_REGISTRY_RATE_LIMIT_RPS=20

# Maximum burst size for the rate limiter.
# Default: 60
PAP_REGISTRY_RATE_LIMIT_BURST=60

# === Request Limits ===

# Maximum allowed HTTP request body size in bytes.
# Default: 262144 (256 KB)
PAP_REGISTRY_MAX_BODY_BYTES=262144

# Maximum advertisements accepted from a single principal DID.
# Default: 100
PAP_REGISTRY_MAX_ADS_PER_PRINCIPAL=100

# === Database (Destructive - use with caution) ===

# Delete the SQLite database file at startup and run migrations on a clean slate.
# **Destructive** — all stored agents, peers, and the node identity are lost.
# Default: false. Set to 1 or true.
# PAP_REGISTRY_RESET_DB=false

# Confirmation guard for the destructive reset_db operation.
# Must be set to "yes-i-understand" in addition to RESET_DB=true for the wipe to occur.
# This prevents accidental DB deletion when env files are copied.
# PAP_REGISTRY_RESET_DB_CONFIRM=yes-i-understand
