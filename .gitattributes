# Normalize line endings to LF on commit, checkout as-is
* text=auto eol=lf

# Ensure Rust source is always LF
*.rs text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.h text eol=lf

# Binary files
*.png binary
*.jpg binary
*.ico binary
*.wasm binary
